                    </GridPane.margin>
                    <font>
                        <Font name="System Italic" size="12.0" />
                    </font>
                </TextField>
                <Label text="IP Adresa:" GridPane.columnIndex="1" GridPane.rowIndex="1" GridPane.valignment="TOP">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <TextField fx:id="ipAddressTextField" GridPane.columnIndex="1" GridPane.rowIndex="1" GridPane.valignment="TOP">
                    <GridPane.margin>
                        <Insets left="65.0" right="20.0" />
                    </GridPane.margin>
                </TextField>
                <ComboBox fx:id="osComboBox" prefWidth="150.0" promptText="Odaberi OS" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.rowIndex="1" GridPane.valignment="CENTER">
                    <GridPane.margin>
                        <Insets top="50.0" />
                    </GridPane.margin>
                </ComboBox>
                <Label text="Operativni Sustav:" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.rowIndex="1">
