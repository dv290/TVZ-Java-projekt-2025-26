                <Label text="Naziv:" GridPane.rowIndex="1" GridPane.valignment="TOP">
                    <font>
                        <Font size="14.0" />
                    </font>
                    <GridPane.margin>
                        <Insets left="10.0" />
                    </GridPane.margin>
                </Label>
                <Label text="Power rating:" GridPane.rowIndex="1">
                    <GridPane.margin>
                        <Insets left="10.0" />
                    </GridPane.margin>
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <TextField fx:id="nameTextField" promptText="Unesi naziv uređaja" GridPane.rowIndex="1" GridPane.valignment="TOP">
                    <GridPane.margin>
                        <Insets left="50.0" right="10.0" />
                    </GridPane.margin>
                    <font>
                        <Font name="System Italic" size="12.0" />
                    </font>
                </TextField>
                <TextField fx:id="powerRatingTextField" promptText="Unesi power rating uređaja" GridPane.rowIndex="1">
